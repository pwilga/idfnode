CONFIG_DEBUG_CONSOLE=y
CONFIG_ENABLE_SUPERVISOR_NETWORK=y
CONFIG_ENABLE_SUPERVISOR_BUTTON=y
CONFIG_ENABLE_SUPERVISOR_SWITCH=y
CONFIG_ENABLE_SUPERVISOR_LIGHT=y

CONFIG_BUTTON_GPIO_LIST="9:0:Boot"
CONFIG_SWITCH_GPIO_LIST="12:1:Fake Switch"

# A fixed color only, no animations: saves the effects task (~3-4 KB RAM)
CONFIG_LIGHT_ENABLE_EFFECTS=n