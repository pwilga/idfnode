CONFIG_ENABLE_SUPERVISOR_DEBUG=y
CONFIG_ENABLE_SUPERVISOR_NETWORK=y
CONFIG_NETWORK_UPLINK_THREAD=y
CONFIG_ENABLE_SUPERVISOR_SWITCH=y

CONFIG_SWITCH_GPIO_LIST="12:1:Fake Switch"

# The rest of Thread's options come with the uplink; this one is a menu choice it can't set
CONFIG_LWIP_HOOK_IP6_SELECT_SRC_ADDR_CUSTOM=y
