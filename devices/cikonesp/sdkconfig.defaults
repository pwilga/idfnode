CONFIG_ENABLE_SUPERVISOR_SWITCH=y

CONFIG_BUTTON_GPIO_LIST="0:0"
CONFIG_SWITCH_GPIO_LIST="2:0:Board Led"

CONFIG_VFS_LITTLEFS_ENABLED=y