CONFIG_ENABLE_SUPERVISOR_INET=y
CONFIG_ENABLE_SUPERVISOR_DEBUG=y
CONFIG_ENABLE_SUPERVISOR_LIGHT=y

# CONFIG_LIGHT_ENABLE_EFFECTS=n


# LOLIN S2 Mini (ESP32-S2FN4R2) configuration

# 2MB PSRAM in the package.
CONFIG_SPIRAM=y
CONFIG_SPIRAM_SPEED_80M=y

# https://docs.espressif.com/projects/esp-idf/en/stable/esp32s2/api-guides/wifi-driver/wifi-performance-and-power-save.html
# "Using PSRAM" table, "Memory saving" rank. The first line is not a row there - it is what puts
# the build into that mode, and is what forces TX static as the section intro describes.
CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP=y
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=6
CONFIG_ESP_WIFI_DYNAMIC_RX_BUFFER_NUM=64
CONFIG_ESP_WIFI_STATIC_TX_BUFFER_NUM=6
CONFIG_ESP_WIFI_RX_BA_WIN=6
CONFIG_LWIP_TCP_SND_BUF_DEFAULT=32768
CONFIG_LWIP_TCP_WND_DEFAULT=32768
CONFIG_ESP_WIFI_IRAM_OPT=y
CONFIG_ESP_WIFI_RX_IRAM_OPT=n
CONFIG_LWIP_IRAM_OPTIMIZATION=n
# 16KB here would cost 8 kB of heap and only buys throughput this device never reaches.
CONFIG_ESP32S2_INSTRUCTION_CACHE_8KB=y
CONFIG_ESP32S2_INSTRUCTION_CACHE_LINE_16B=y
CONFIG_ESP32S2_DATA_CACHE_8KB=y
CONFIG_ESP32S2_DATA_CACHE_LINE_32B=y

# Due to DRAM limitation put as many things as it is possible into PSRAM
CONFIG_MBEDTLS_EXTERNAL_MEM_ALLOC=y
# Helper for selecting both SPIRAM_FETCH_INSTRUCTIONS and SPIRAM_RODATA
CONFIG_SPIRAM_XIP_FROM_PSRAM=y

CONFIG_SPIRAM_ALLOW_BSS_SEG_EXTERNAL_MEMORY=y
