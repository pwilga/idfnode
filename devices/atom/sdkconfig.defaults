CONFIG_ESPTOOLPY_FLASHSIZE_8MB=y

CONFIG_ENABLE_SUPERVISOR_BUTTON=y
CONFIG_ENABLE_SUPERVISOR_DEBUG=y
CONFIG_ENABLE_SUPERVISOR_SWITCH=y
# CONFIG_ENABLE_SUPERVISOR_DS18B20=y
# CONFIG_ENABLE_SUPERVISOR_ESP_NOW_RX=y
# CONFIG_ENABLE_SUPERVISOR_LED=y
# CONFIG_ENABLE_SUPERVISOR_RF433=y
# CONFIG_ENABLE_SUPERVISOR_ZIGBEE=y
CONFIG_ENABLE_SUPERVISOR_LED_INDICATOR=y

CONFIG_BUTTON_GPIO_LIST="41:0"
CONFIG_SWITCH_GPIO_LIST="5:1:Fake Switch"

CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y

# Two HTTP servers need more than the shared 16
CONFIG_LWIP_MAX_SOCKETS=20

CONFIG_ENABLE_SUPERVISOR_NETWORK=y
CONFIG_NETWORK_UPLINK_ETHERNET=y
CONFIG_ETHERNET_W5500=y

# The rest of the border router's IDF options: its Kconfig.projbuild
CONFIG_ENABLE_SUPERVISOR_THREAD_BORDER_ROUTER=y
CONFIG_THREAD_BORDER_ROUTER_WEB=y

# Uncomment for TCP OTA (push-based) — required to buffer large in-flight data over Thread
# CONFIG_OPENTHREAD_NUM_MESSAGE_BUFFERS=256
